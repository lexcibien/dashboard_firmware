# Shared configuration for the ESP-IDF dashboard application.
# Board-specific values remain in sdkconfig and menuconfig.
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=n
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LIBC_NEWLIB=y
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y

# TFT_eSPI GC9A01 provisional smoke-test configuration.
CONFIG_TFT_GC9A01_DRIVER=y
CONFIG_TFT_WIDTH=240
CONFIG_TFT_HEIGHT=240
CONFIG_TFT_SPI=y
CONFIG_TFT_VSPI_PORT=y
CONFIG_TFT_MISO=-1
CONFIG_TFT_MOSI=19
CONFIG_TFT_SCLK=18
CONFIG_TFT_SPI_FREQUENCY=20000000
CONFIG_TFT_SPI_READ_FREQ=-1
CONFIG_TFT_CS=20
CONFIG_TFT_DC=17
CONFIG_TFT_RST=16
CONFIG_ENABLE_BL=n
CONFIG_TFT_LOAD_GFXFF=y
CONFIG_TFT_SMOOTH_FONT=y
